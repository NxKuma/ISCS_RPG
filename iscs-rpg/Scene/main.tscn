	vec3 n_out13p0;
// If:13
	float n_in13p2 = 0.00001;
	vec3 n_in13p3 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out4p0.x - n_out8p0) < n_in13p2)
	{
		n_out13p0 = n_in13p3;
	}
	else if(n_out4p0.x < n_out8p0)
	{
		n_out13p0 = vec3(n_out7p0);
	}
	else
	{
		n_out13p0 = vec3(n_out6p0);
	}


// Mix:14
	vec3 n_out14p0 = mix(vec3(n_out17p0.xyz), vec3(n_out10p0.xyz), n_out13p0);


// FloatOp:16
	float n_in16p1 = 0.03000;
	float n_out16p0 = n_out8p0 + n_in16p1;


	vec3 n_out5p0;
// If:5
	float n_in5p2 = 0.00001;
	vec3 n_in5p3 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out4p0.x - n_out16p0) < n_in5p2)
	{
		n_out5p0 = n_in5p3;
	}
	else if(n_out4p0.x < n_out16p0)
	{
		n_out5p0 = vec3(n_out7p0);
	}
	else
	{
		n_out5p0 = vec3(n_out6p0);
	}


// Mix:11
	float n_in11p0 = 0.00000;
	float n_out11p0 = mix(n_in11p0, n_out5p0.x, n_out10p4);


// Output:0
	COLOR.rgb = n_out14p0;
	COLOR.a = n_out11p0;


