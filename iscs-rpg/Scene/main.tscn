code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter2 : source_color;
uniform float DissolveValue : hint_range(0, 1);



void fragment() {
	vec4 n_out33p0;
// Texture2D:33
	n_out33p0 = texture(TEXTURE, UV);
	float n_out33p4 = n_out33p0.a;


// ColorParameter:37
	vec4 n_out37p0 = ColorParameter2;


	vec3 n_out36p0;
// If:36
	float n_in36p1 = 0.00000;
	float n_in36p2 = 0.00001;
	vec3 n_in36p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out33p4 - n_in36p1) < n_in36p2)
	{
		n_out36p0 = vec3(n_out37p0.xyz);
	}
	else if(n_out33p4 < n_in36p1)
	{
		n_out36p0 = n_in36p5;
	}
	else
	{
		n_out36p0 = vec3(n_out33p0.xyz);
	}


// FloatOp:30
	float n_in30p0 = 0.00000;
	float n_in30p1 = 0.00000;
	float n_out30p0 = n_in30p0 + n_in30p1;


// Input:23
	vec2 n_out23p0 = UV;


// VectorCompose:22
	float n_in22p0 = -1.00000;
	float n_in22p1 = 0.00000;
	vec2 n_out22p0 = vec2(n_in22p0, n_in22p1);


// FloatParameter:8
	float n_out8p0 = DissolveValue;


// VectorOp:19
	vec3 n_out19p0 = vec3(n_out22p0, 0.0) * vec3(n_out8p0);


// VectorOp:20
	vec2 n_out20p0 = n_out23p0 - vec2(n_out19p0.xy);


	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(TEXTURE, n_out20p0);
	float n_out18p4 = n_out18p0.a;


// FloatOp:31
	float n_out31p0 = n_out30p0 + n_out18p4;


// Input:29
	vec2 n_out29p0 = UV;


// VectorCompose:28
	float n_in28p0 = 0.00000;
	float n_in28p1 = -1.00000;
	vec2 n_out28p0 = vec2(n_in28p0, n_in28p1);


// VectorOp:25
	vec3 n_out25p0 = vec3(n_out28p0, 0.0) * vec3(n_out8p0);


// VectorOp:26
	vec2 n_out26p0 = n_out29p0 - vec2(n_out25p0.xy);


	vec4 n_out24p0;
// Texture2D:24
	n_out24p0 = texture(TEXTURE, n_out26p0);
	float n_out24p4 = n_out24p0.a;


// FloatOp:32
	float n_out32p0 = n_out31p0 + n_out24p4;


// FloatOp:35
	float n_out35p0 = n_out32p0 + n_out33p4;


// Output:0
	COLOR.rgb = n_out36p0;
	COLOR.a = n_out35p0;


}
